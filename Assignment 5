from collections import Counter


POSITIVE = {"good", "clean", "fast", "helpful", "improved"}
NEGATIVE = {"bad", "dirty", "slow", "rude", "smoke", "broken"}
NEGATORS = {"not", "never", "no"}

STOP_WORDS = {
    "the", "is", "a", "an", "and", "of", "in", "to",
    "was", "are", "it", "for", "on", "with", "from",
    "but", "this", "that", "were"
}


def score(text):
    words = re.findall(r"\b[a-z]+\b", text.lower())
    total = 0

    for i, word in enumerate(words):
        if word in POSITIVE:
            value = 1
        elif word in NEGATIVE:
            value = -1
        else:
            value = 0

        if i > 0 and words[i - 1] in NEGATORS:
            value = -value

        total += value

    if total > 0:
        return "positive"
    elif total < 0:
        return "negative"
    return "neutral"


def summarise(text, k=2, frequencies=None):
    sentences = re.split(r"(?<=[.!?])\s+", text.strip())
    sentences = [s for s in sentences if s]

    if frequencies is None:
        words = re.findall(r"\b[a-z]+\b", text.lower())
        frequencies = Counter(
            word for word in words if word not in STOP_WORDS
        )

    scored = []

    for index, sentence in enumerate(sentences):
        words = re.findall(r"\b[a-z]+\b", sentence.lower())
        importance = sum(frequencies[word] for word in words)
        scored.append((importance, index, sentence))

    selected = sorted(scored, key=lambda x: (-x[0], x[1]))[:k]
    selected.sort(key=lambda x: x[1])

    return "\n".join(item[2] for item in selected)


def first_k_summary(text, k=2):
    sentences = re.split(r"(?<=[.!?])\s+", text.strip())
    sentences = [s for s in sentences if s]
    return "\n".join(sentences[:k])


