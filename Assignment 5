print("\n4. SQLITE DATABASE INDEXING")

con = sqlite3.connect(":memory:")

con.execute("""
CREATE TABLE aq (
    station TEXT,
    day TEXT,
    pm25 REAL
)
""")

readings = []

for i in range(50000):
    station = "Adyar" if i % 2 == 0 else "Guindy"
    day = f"2026-10-{(i % 30) + 1:02d}"
    pm25 = float((i % 150) + 10)
    readings.append((station, day, pm25))

con.executemany(
    "INSERT INTO aq VALUES (?, ?, ?)",
    readings
)

con.commit()

query = """
SELECT station, day, AVG(pm25)
FROM aq
WHERE station = ?
AND day BETWEEN ? AND ?
GROUP BY station, day
"""


def measure_query():
    start = time.perf_counter()

    for i in range(100):
        con.execute(
            query,
            ("Adyar", "2026-10-01", "2026-10-31")
        ).fetchall()

    end = time.perf_counter()
    return end - start


before = measure_query()

print("Time Before Index:", round(before, 6), "seconds")

con.execute("""
CREATE INDEX idx_station_day
ON aq(station, day)
""")

con.commit()

after = measure_query()

print("Time After Index:", round(after, 6), "seconds")

if before > 0:
    improvement = ((before - after) / before) * 100
    print("Performance Improvement:", round(improvement, 2), "%")

print("\nQuery Execution Plan:")

plan = con.execute(
